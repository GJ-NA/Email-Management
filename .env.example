# Email Management 本地配置模板
# 复制为 .env 后再按实际环境修改。不要提交 .env、.env.local 或其中的真实凭据。

# Flask 基础配置
SECRET_KEY=replace-with-a-long-random-secret
LOGIN_PASSWORD=replace-with-a-strong-admin-password

# 本地启动脚本使用的地址和数据目录
HOST=127.0.0.1
PORT=5000
FLASK_ENV=production
EMAIL_MANAGEMENT_HOME=runtime
DATABASE_PATH=runtime/data/outlook_accounts.db
LOG_LEVEL=WARNING

# Graph / IMAP 网络超时和批量任务并发
HTTP_REQUEST_TIMEOUT=30
IMAP_TIMEOUT=45
REFRESH_CONCURRENCY=8
VERIFY_CONCURRENCY=8

# TLS always verifies certificates; optionally trust a private mail-server CA.
# MAIL_TLS_CA_FILE=C:/path/to/mail-ca.pem

# Forwarded headers are ignored unless the immediate proxy IP is trusted.
# Comma-separated IPs/CIDRs; never include untrusted clients or 0.0.0.0/0.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# GitHub 版本检查和界面链接
REPOSITORY_OWNER=GJ-NA
REPOSITORY_NAME=Email-Management
# REPOSITORY_URL=https://github.com/GJ-NA/Email-Management

# OAuth 助手配置（可选）
# OAUTH_CLIENT_ID=your-azure-application-client-id
# OAUTH_REDIRECT_URI=http://localhost:8080

# 临时邮箱服务（可选）
GPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=
DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# Docker 在线更新（默认关闭）
DOCKER_UPDATE_ENABLED=false
# DOCKER_UPDATE_CONTAINER=email-management
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=300
